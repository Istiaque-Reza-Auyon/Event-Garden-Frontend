# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# PostgreSQL connection string used by the API routes and by drizzle-kit migrations.
# The database (and its tables) are created automatically if they don't exist yet.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/event_garden

# Set to "false" to stop the app from creating the database/tables itself
# (then run `npm run db:init` as a deploy step instead). Defaults to true.
# DATABASE_AUTO_INIT=true

# Secret used to sign session tokens. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string-of-32+-chars

# --- Legacy: external backend URL --------------------------------------------
# Only the Explore page still uses this; everything else uses the built-in API.
NEXT_PUBLIC_URL=

# Cloudinary image uploads (event posters, organization logos, profile pictures).
# Uses an *unsigned* upload preset. Optional: without it, uploads show a message.
# NEXT_PUBLIC_* values are baked in at build time, so rebuild after changing them.
# Example: NEXT_PUBLIC_CLOUDINARY_URL=https://api.cloudinary.com/v1_1/my-cloud/image/upload
NEXT_PUBLIC_CLOUDINARY_URL=
NEXT_PUBLIC_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUD_NAME=
